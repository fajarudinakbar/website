      "destination": "/index.html"
    },
    {
      "source": "/en/",
      "destination": "/index.html"
    },
    {
      "source": "/english",
      "destination": "/index.html"
    },
    {
      "source": "/english/",
      "destination": "/index.html"
    },
    {
      "source": "/kursus",
      "destination": "/index.html"
    },
    {
      "source": "/kursus/",
      "destination": "/index.html"
    }
  ]
